+        try { return ${JSON.stringify(report)}; }
+        finally {
+          await new Promise(resolve => setTimeout(resolve, 20));
+          throw new Error("fixture cleanup failed");
+        }
+      }`,
+      /fixture cleanup failed/,
+    ],
+  ];
+  for (const [name, run, pattern] of cases) {
