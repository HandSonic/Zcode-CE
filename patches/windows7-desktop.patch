--- /dev/null
+++ b/scripts/bundle-desktop-win7.mjs
@@ -0,0 +1,44 @@
+import { existsSync } from "node:fs";
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { spawn } from "node:child_process";
+import {
+  prepareWindows7Archive,
+  verifyWindows7Archive,
+} from "../packages/desktop/scripts/windows7-runtime.mjs";
+
+export async function main(args = process.argv.slice(2)) {
+  if (args.some((arg) => arg !== "--prepare-only")) {
+    throw new Error("Only --prepare-only is supported; Win7 bundles must rebuild application code");
+  }
+  const root = resolve(import.meta.dirname, "..");
+  const destination = resolve(root, "packages/desktop/.cache/win7/electron-v44.2.0-win32-x64.zip");
+  const configured = process.env.ZCODE_WIN7_ELECTRON_ZIP;
+  const archive = configured || (existsSync(destination) ? destination : undefined);
+  const runtimePath = archive
+    ? await verifyWindows7Archive(archive)
+    : await prepareWindows7Archive({ destination });
+  console.log(`[win7] verified runtime: ${runtimePath}`);
+  if (args.includes("--prepare-only")) return;
+  const child = spawn(process.execPath, ["scripts/bundle.mjs", "--os", "win", "--arch", "x64"], {
+    cwd: resolve(root, "packages/desktop"),
+    stdio: "inherit",
+    env: {
+      ...process.env,
+      ZCODE_WINDOWS7: "1",
+      ZCODE_WIN7_ELECTRON_ZIP: runtimePath,
+      ZCODE_DESKTOP_DIST_DIR: "dist-win7",
+      ZCODE_SKIP_PREPARE: "0",
+      ZCODE_SKIP_BUILD: "0",
+    },
+  });
+  await new Promise((resolveRun, reject) => {
+    child.once("error", reject);
+    child.once("exit", (code, signal) => {
+      if (code === 0) resolveRun();
+      else reject(new Error(`Win7 bundle failed: ${signal || code}`));
+    });
+  });
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) await main();
diff --git a/scripts/smoke-win7-desktop.cjs b/scripts/smoke-win7-desktop.cjs
new file mode 100644
index 0000000..50d0d71
--- /dev/null
+++ b/scripts/smoke-win7-desktop.cjs
@@ -0,0 +1,93 @@
+// 使用安装目录中的 EXE + ELECTRON_RUN_AS_NODE=1 执行，验证最终包而非开发依赖。
+const assert = require("node:assert/strict");
+const { mkdtemp, rm } = require("node:fs/promises");
+const { createRequire } = require("node:module");
+const { tmpdir, release } = require("node:os");
+const { dirname, join } = require("node:path");
+const { DatabaseSync } = require("node:sqlite");
+const { spawnSync } = require("node:child_process");
+
+async function main() {
+  assert.equal(process.platform, "win32", "需要 Windows 上的最终桌面包");
+  assert.equal(process.versions.electron, "44.2.0", "不能混入官方桌面运行时");
+  if (process.argv.includes("--require-win7")) assert.match(release(), /^6\.1\./);
+  const appRoot = dirname(process.execPath);
+  const appRequire = createRequire(join(appRoot, "resources/app.asar/package.json"));
+  assert.equal(appRequire("./package.json").zcodeWindows7, true);
+  const nodePty = appRequire("node-pty");
+  for (const [directory, executable] of [
+    ["ripgrep", "rg.exe"],
+    ["ugrep", "ugrep.exe"],
+  ]) {
+    const result = spawnSync(
+      join(appRoot, "resources/tools", directory, executable),
+      ["--version"],
+      {
+        encoding: "utf8",
+        timeout: 15_000,
+        windowsHide: true,
+      },
+    );
+    if (result.error) throw result.error;
+    assert.equal(result.status, 0, `${executable}: ${result.stderr}`);
+  }
+  const directory = await mkdtemp(join(tmpdir(), "zcode-win7-smoke-"));
+  try {
+    const databasePath = join(directory, "smoke.sqlite");
+    const db = new DatabaseSync(databasePath);
+    try {
+      db.exec("CREATE TABLE smoke (value TEXT); INSERT INTO smoke VALUES ('persisted')");
+    } finally {
+      db.close();
+    }
+    const reopened = new DatabaseSync(databasePath);
+    try {
+      assert.equal(reopened.prepare("SELECT value FROM smoke").get().value, "persisted");
+    } finally {
+      reopened.close();
+    }
+    await new Promise((resolve, reject) => {
+      let output = "";
+      const pty = nodePty.spawn(process.env.ComSpec || "cmd.exe", ["/d", "/q"], {
+        cwd: directory,
+        env: process.env,
+        cols: 80,
+        rows: 24,
+        useConpty: false,
+      });
+      const timer = setTimeout(() => {
+        pty.kill();
+        reject(new Error("WinPTY smoke timed out"));
+      }, 15_000);
+      pty.onData((data) => {
+        output += data;
+      });
+      pty.onExit(({ exitCode }) => {
+        clearTimeout(timer);
+        try {
+          assert.equal(exitCode, 0);
+          assert.match(output, /(?:^|[\r\n])ZCODE_WIN7_PTY_OK(?:[\r\n]|$)/);
+          resolve();
+        } catch (error) {
+          reject(error);
+        }
+      });
+      pty.resize(100, 30);
+      pty.write("set ZCODE_SMOKE=OK\r\necho ZCODE_WIN7_PTY_%ZCODE_SMOKE%\r\nexit /b 0\r\n");
+    });
+    console.log(
+      JSON.stringify({
+        ok: true,
+        windows: release(),
+        versions: process.versions,
+        checks: ["packaged-runtime", "sqlite-reopen", "winpty-input-output-resize-exit"],
+      }),
+    );
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+}
+main().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
