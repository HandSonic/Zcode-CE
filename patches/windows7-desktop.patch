+
+test("独立 smoke 的 stdout 或 stderr 写入回调失败也必须非零退出", async (t) => {
+  for (const stream of ["stdout", "stderr"]) {
+    await t.test(stream, async (t) => {
+      const run =
+        stream === "stdout"
