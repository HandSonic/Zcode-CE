+import { existsSync } from "node:fs";
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { spawn } from "node:child_process";
+import {
+  prepareWindows7Archive,
+  verifyWindows7Archive,
+} from "../packages/desktop/scripts/windows7-runtime.mjs";
+
+export async function main(args = process.argv.slice(2)) {
+  if (args.some((arg) => arg !== "--prepare-only")) {
+    throw new Error("Only --prepare-only is supported; Win7 bundles must rebuild application code");
+  }
+  const root = resolve(import.meta.dirname, "..");
+  const destination = resolve(root, "packages/desktop/.cache/win7/electron-v44.2.0-win32-x64.zip");
+  const configured = process.env.ZCODE_WIN7_ELECTRON_ZIP;
+  const archive = configured || (existsSync(destination) ? destination : undefined);
+  const runtimePath = archive
+    ? await verifyWindows7Archive(archive)
+    : await prepareWindows7Archive({ destination });
+  console.log(`[win7] verified runtime: ${runtimePath}`);
+  if (args.includes("--prepare-only")) return;
+  const child = spawn(process.execPath, ["scripts/bundle.mjs", "--os", "win", "--arch", "x64"], {
+    cwd: resolve(root, "packages/desktop"),
+    stdio: "inherit",
+    env: {
+      ...process.env,
+      ZCODE_WINDOWS7: "1",
+      ZCODE_WIN7_ELECTRON_ZIP: runtimePath,
+      ZCODE_DESKTOP_DIST_DIR: "dist-win7",
+      ZCODE_SKIP_PREPARE: "0",
+      ZCODE_SKIP_BUILD: "0",
+    },
+  });
+  await new Promise((resolveRun, reject) => {
+    child.once("error", reject);
+    child.once("exit", (code, signal) => {
+      if (code === 0) resolveRun();
+      else reject(new Error(`Win7 bundle failed: ${signal || code}`));
+    });
+  });
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) await main();
diff --git a/scripts/run-win7-smoke.mjs b/scripts/run-win7-smoke.mjs
new file mode 100644
index 0000000..442c701
--- /dev/null
+++ b/scripts/run-win7-smoke.mjs
@@ -0,0 +1,76 @@
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { promisify } from "node:util";
+import { SMOKE_PREFIX, parseSmokeResult } from "./win7-smoke-contract.cjs";
+
+const exec = promisify(execFile);
+const defaultScript = fileURLToPath(new URL("./smoke-win7-desktop.cjs", import.meta.url));
+
+export async function runWin7Smoke({
+  executable,
+  scriptPath = defaultScript,
+  requireWin7 = false,
+  timeout = 60_000,
+}) {
+  assert.ok(typeof executable === "string" && executable.length > 0, "Missing packaged executable");
+  assert.ok(Number.isSafeInteger(timeout) && timeout > 0, "Smoke timeout must be positive");
+  let result;
+  try {
+    // Node 等待真实子进程结束；Windows GUI EXE 不能依赖 shell 的隐式等待或旧退出码。
+    result = await exec(
+      executable,
+      [resolve(scriptPath), ...(requireWin7 ? ["--require-win7"] : [])],
+      {
+        env: { ...process.env, ELECTRON_RUN_AS_NODE: "1" },
+        encoding: "utf8",
+        windowsHide: true,
+        timeout,
+        killSignal: "SIGKILL",
+        maxBuffer: 4 * 1024 * 1024,
+      },
+    );
+  } catch (cause) {
+    const error = new Error(
+      cause.killed
+        ? `Win7 smoke process timed out after ${timeout} ms`
+        : `Win7 smoke process failed (${cause.code || cause.signal || "spawn error"})`,
+      { cause },
+    );
+    error.stdout = cause.stdout || "";
+    error.stderr = cause.stderr || "";
+    throw error;
+  }
+  // 即使错误路径意外退出 0，没有完整成功报告也不能通过发布门禁。
+  try {
+    const report = parseSmokeResult(result.stdout);
+    if (requireWin7) assert.match(report.windows, /^6\.1\./, "Smoke must run on Windows 7");
+    return { ...result, report };
+  } catch (error) {
+    error.stdout = result.stdout;
+    error.stderr = result.stderr;
+    throw error;
+  }
+}
+
+async function main() {
+  const args = process.argv.slice(2);
+  if (args.length < 1 || args.length > 2 || (args.length === 2 && args[1] !== "--require-win7"))
+    throw new Error("Usage: node scripts/run-win7-smoke.mjs <packaged-exe> [--require-win7]");
+  const result = await runWin7Smoke({
+    executable: args[0],
+    requireWin7: args[1] === "--require-win7",
+  });
+  if (result.stderr) process.stderr.write(result.stderr);
+  console.log(`${SMOKE_PREFIX}${JSON.stringify(result.report)}`);
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  main().catch((error) => {
+    if (error.stdout) process.stdout.write(error.stdout);
+    if (error.stderr) process.stderr.write(error.stderr);
+    console.error(error);
+    process.exitCode = 1;
+  });
+}
diff --git a/scripts/smoke-win7-desktop.cjs b/scripts/smoke-win7-desktop.cjs
new file mode 100644
index 0000000..2b2cf64
--- /dev/null
+++ b/scripts/smoke-win7-desktop.cjs
@@ -0,0 +1,103 @@
+// 使用安装目录中的 EXE + ELECTRON_RUN_AS_NODE=1 执行，验证最终包而非开发依赖。
+const assert = require("node:assert/strict");
+const { mkdtemp, rm } = require("node:fs/promises");
+const { createRequire } = require("node:module");
+const { tmpdir, release } = require("node:os");
+const { dirname, join, sep } = require("node:path");
+const { DatabaseSync } = require("node:sqlite");
+const { spawnSync } = require("node:child_process");
+const { assertWinptyOutput, finishSmokeProcess } = require("./win7-smoke-contract.cjs");
+
+async function main() {
+  assert.equal(process.platform, "win32", "需要 Windows 上的最终桌面包");
+  assert.equal(process.versions.electron, "44.2.0", "不能混入官方桌面运行时");
+  if (process.argv.includes("--require-win7"))
+    assert.match(release(), /^6\.1\./, "Windows 7 required for --require-win7");
+  const appRoot = dirname(process.execPath);
+  const appRequire = createRequire(join(appRoot, "resources/app.asar/package.json"));
+  assert.equal(appRequire("./package.json").zcodeWindows7, true);
+  // 未安装包内依赖时，不能向上回退到构建工作区的 node_modules 后误报成功。
+  const ptyEntry = appRequire.resolve("node-pty").toLowerCase();
+  assert.ok(
+    ["app.asar", "app.asar.unpacked"].some((name) =>
+      ptyEntry.startsWith((join(appRoot, "resources", name) + sep).toLowerCase()),
+    ),
+    "node-pty must resolve inside the packaged application",
+  );
+  const nodePty = appRequire("node-pty");
+  for (const [directory, executable] of [
+    ["ripgrep", "rg.exe"],
+    ["ugrep", "ugrep.exe"],
+  ]) {
+    const result = spawnSync(
+      join(appRoot, "resources/tools", directory, executable),
+      ["--version"],
+      {
+        encoding: "utf8",
+        timeout: 15_000,
+        windowsHide: true,
+      },
+    );
+    if (result.error) throw result.error;
+    assert.equal(result.status, 0, `${executable}: ${result.stderr}`);
+  }
+  const directory = await mkdtemp(join(tmpdir(), "zcode-win7-smoke-"));
+  try {
+    const databasePath = join(directory, "smoke.sqlite");
+    const db = new DatabaseSync(databasePath);
+    try {
+      db.exec("CREATE TABLE smoke (value TEXT); INSERT INTO smoke VALUES ('persisted')");
+    } finally {
+      db.close();
+    }
+    const reopened = new DatabaseSync(databasePath);
+    try {
+      assert.equal(reopened.prepare("SELECT value FROM smoke").get().value, "persisted");
+    } finally {
+      reopened.close();
+    }
+    await new Promise((resolve, reject) => {
+      let output = "";
+      const pty = nodePty.spawn(process.env.ComSpec || "cmd.exe", ["/d", "/q"], {
+        cwd: directory,
+        env: process.env,
+        cols: 80,
+        rows: 24,
+        useConpty: false,
+      });
+      const timer = setTimeout(() => {
+        pty.kill();
+        reject(new Error("WinPTY smoke timed out"));
+      }, 15_000);
+      pty.onData((data) => {
+        output += data;
+      });
+      pty.onExit(({ exitCode }) => {
+        clearTimeout(timer);
+        try {
+          assert.equal(exitCode, 0);
+          assertWinptyOutput(output);
+          resolve();
+        } catch (error) {
+          reject(error);
+        }
+      });
+      pty.resize(100, 30);
+      pty.write("set ZCODE_SMOKE=OK\r\necho ZCODE_WIN7_PTY_%ZCODE_SMOKE%\r\nexit /b 0\r\n");
+    });
+    return {
+      ok: true,
+      windows: release(),
+      versions: process.versions,
+      checks: [
+        "packaged-runtime",
+        "sqlite-reopen",
+        "winpty-input-output-resize-exit",
+        "search-tools",
+      ],
+    };
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+}
+finishSmokeProcess(main);
diff --git a/scripts/win7-smoke-contract.cjs b/scripts/win7-smoke-contract.cjs
new file mode 100644
index 0000000..d835eda
--- /dev/null
+++ b/scripts/win7-smoke-contract.cjs
@@ -0,0 +1,65 @@
+const assert = require("node:assert/strict");
+const { stripVTControlCharacters } = require("node:util");
+
+const SMOKE_PREFIX = "ZCODE_WIN7_SMOKE_RESULT=";
+const SMOKE_CHECKS = Object.freeze([
+  "packaged-runtime",
+  "sqlite-reopen",
+  "winpty-input-output-resize-exit",
+  "search-tools",
+]);
+
+function assertWinptyOutput(output) {
+  // WinPTY 返回的真实结果行可能以擦除行尾等 ANSI 控制序列结尾，先去掉控制序列再判断。
+  assert.match(
+    stripVTControlCharacters(output),
+    /(?:^|[\r\n])ZCODE_WIN7_PTY_OK(?:[\r\n]|$)/,
+    "WinPTY must emit an independent successful command result line",
+  );
+}
+
+function parseSmokeResult(stdout) {
+  const reports = stdout.split(/\r?\n/).filter((line) => line.startsWith(SMOKE_PREFIX));
+  assert.equal(reports.length, 1, "Expected exactly one Win7 smoke success report");
+  const report = JSON.parse(reports[0].slice(SMOKE_PREFIX.length));
+  assert.ok(report && typeof report === "object" && !Array.isArray(report), "Invalid smoke report");
+  assert.equal(report.ok, true, "Win7 smoke report is not successful");
+  assert.match(report.windows || "", /^\d+\.\d+\.\d+(?:\.\d+)?$/, "Missing valid Windows version");
+  assert.equal(report.versions?.electron, "44.2.0", "Unexpected packaged Electron version");
+  assert.ok(
+    Array.isArray(report.checks) &&
+      report.checks.every((name) => typeof name === "string") &&
+      SMOKE_CHECKS.every((name) => report.checks.includes(name)),
+    "Win7 smoke report is missing required checks",
+  );
+  return report;
+}
+
+function writeAndExit(stream, output, exitCode) {
+  try {
+    stream.write(output, (error) => process.exit(error ? 1 : exitCode));
+  } catch {
+    process.exit(1);
+  }
+}
+
+function finishSmokeProcess(run) {
+  // WinPTY 已退出后，node-pty 的 worker 仍可能保活。独立 CLI 必须等全部检查、清理
+  // 完成，且成功报告写入回调结束后再显式退出；写入失败不能被当作成功。
+  return Promise.resolve()
+    .then(run)
+    .then((report) => {
+      writeAndExit(process.stdout, `${SMOKE_PREFIX}${JSON.stringify(report)}\n`, 0);
+    })
+    .catch((error) => {
+      writeAndExit(process.stderr, `${error?.stack || String(error)}\n`, 1);
+    });
+}
+
+module.exports = {
+  SMOKE_PREFIX,
+  SMOKE_CHECKS,
+  assertWinptyOutput,
+  parseSmokeResult,
+  finishSmokeProcess,
+};
